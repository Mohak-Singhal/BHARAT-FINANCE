NEXT_PUBLIC_APP_NAME=Bharat Finance Platform
NEXT_PUBLIC_APP_VERSION=1.0.0

# AI Coach API Keys
# Use GROQ_API_KEY (recommended) or GOOGLE_API_KEY (Gemini fallback).
# Both are read on the server only - add them in the Vercel dashboard.
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# YouTube Data API (Learning Content)
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# News API (Financial News Feed) - server-side proxy uses NEWS_API_KEY first
NEWS_API_KEY=your_news_api_key_here
NEXT_PUBLIC_NEWS_API_KEY=your_news_api_key_here

# Alpha Vantage API (Stock Tracker) - server-side proxy uses ALPHA_VANTAGE_API_KEY first
# Free tier is limited to 25 requests/day - the proxy caches results for 10-15 minutes
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here
NEXT_PUBLIC_ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here